<div class='container'>
  <div class='row'>
    <div class='col-md-3'>
      <h2>User info</h2>
      <%= render 'users/info', user: @user %>
      <h2 class="mt-3">New book</h2>
      <%= render 'layouts/errors', obj: @book_new %> 
      <%= render 'books/form', book: @book_new %>
    </div>
    <div class='col-md-8 offset-md-1'>
  		<h2>Book detail</h2>
  		<table class='table'>
  		  <tr>
          <td><%= link_to(@book.user) do %>
            <%= image_tag @book.user.get_profile_image, size:"100x100" %><br>
            <%= @book.user.name %>
            <% end %>
          </td>
          <td><%= link_to @book.title, @book %></td>
          <td><%= @book.body %></td>
          <td><%= render 'books/favorite_btn', book: @book %></td>
          <% if @book.user == current_user %>
            <td><%= link_to 'Edit', edit_book_path(@book), class: "btn btn-sm btn-success" %></td>
            <td><%= link_to 'Destroy', @book, method: :delete, data: { confirm: '本当に消しますか？' }, class: "btn btn-sm btn-danger"%></td>
          <% end %>
        </tr>
      </table>
      <h3>コメント一覧 (<%= @book.book_comments.count %>件)</h3>
        <div id="comments_area">
          <% @book.book_comments.each do |book_comment| %>
            <div class="comment-item border-bottom py-2">
              <%= image_tag book_comment.user.get_profile_image, size:"50x50" %><br>
              <%= link_to book_comment.user.name, user_path(book_comment.user) %>
              <p><%= book_comment.comment %></p>
              <small class="text-muted"><%= book_comment.created_at.strftime("%Y/%m/%d %H:%M") %></small>
              <% if book_comment.user == current_user %>
                <%= link_to "削除", book_book_comment_path(book_comment.book, book_comment), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-sm ml-3" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <h4 class="mt-4">コメント投稿</h4>
        <%= form_with model: [@book, BookComment.new], local: true do |f| %>
          <div class="form-group">
            <%= f.text_area :comment, rows: '5', class: "form-control" %>
          </div>
          <%= f.submit "送信", class: "btn btn-success" %>
        <% end %>

      <% if flash[:error].present? %>
        <div class="alert alert-danger mt-3">
          <% flash[:error].each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
