<div class='container'>
  <div class='row'>
    <div class='col-md-3'>
      <h2>User info</h2>
      <%= render 'users/info', user: @user %>
      <h2 class="mt-3">New book</h2>
      <%= render 'layouts/errors', obj: @book_new %> 
      <%= render 'books/form', book: @book_new %>
    </div>
    <div class='col-md-8 offset-md-1'>
  		<h2>Book detail</h2>
  		<table class='table'>
  		  <tr>
          <td><%= link_to(@book.user) do %>
            <%= image_tag @book.user.get_profile_image, size:"100x100" %><br>
            <%= @book.user.name %>
            <% end %>
          </td>
          <td><%= link_to @book.title, @book %></td>
          <td><%= @book.body %></td>
          <td id="favorite_btn_<%= @book.id %>">
            <%= render 'books/favorite_btn', book: @book %>
          </td>
          <% if @book.user == current_user %>
            <td><%= link_to 'Edit', edit_book_path(@book), class: "btn btn-sm btn-success" %></td>
            <td><%= link_to 'Destroy', @book, method: :delete, data: { confirm: '本当に消しますか？' }, class: "btn btn-sm btn-danger"%></td>
          <% end %>
        </tr>
      </table>
      <h3>コメント一覧 (<%= @book.book_comments.count %>件)</h3>
        <div id="comment_list">
          <%= render 'book_comments/comment_list', book: @book %>
        </div>
      <h4 class="mt-4">コメント投稿</h4>
        <%= form_with(model: [@book, @book_comment], local: false, html: { id: "comment_form_#{@book.id}" }) do |f| %>
          <div class="form-group">
            <%= f.text_area :comment, rows: '5', class: "form-control" %>
          </div>
          <%= f.submit "送信", class: "btn btn-success" %>
        <% end %>

      <% if flash[:error].present? %>
        <div class="alert alert-danger mt-3">
          <% flash[:error].each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
