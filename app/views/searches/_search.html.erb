<div class="row">
  <div class="col-md-6 mx-auto">
    <%= form_with(url: search_path, local: true, method: :get) do |f| %>
      <div class="input-group">
        <%= f.select :model, options_for_select([['User', 'User'], ['Book', 'Book']]), {}, class: "form-control" %>
        
        <%= f.select :method, options_for_select([['完全一致', 'perfect'], ['前方一致', 'forward'], ['後方一致', 'backward'], ['部分一致', 'partial']]), {}, class: "form-control" %>
        
        <%= f.text_field :content, class: "form-control", placeholder: "キーワードを入力" %>
        
        <div class="input-group-append">
          <%= f.submit "検索", class: "btn btn-info" %>
        </div>
      </div>
    <% end %>
  </div>
</div>