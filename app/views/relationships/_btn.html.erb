<% if current_user != user %>
  <% if current_user.following?(user) %>
    <%= link_to "Unfollow", user_relationship_path(user.id), method: :delete, class: "btn btn-danger" %>
  <% else %>
    <%= link_to "Follow", user_relationships_path(followed_id: user.id), method: :post, class: "btn btn-success" %>
  <% end %>
<% end %>